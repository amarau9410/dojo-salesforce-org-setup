    <fields>
        <fullName>SC_CardEnding__c</fullName>
        <description>Last digits of the card used in the transaction.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the last four digits of the card.</inlineHelpText>
        <label>Card Ending</label>
        <length>19</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SC_CardMachineCharge__c</fullName>
        <description>Amount to be charged to the customer for non returned or damaged card machines.</description>
        <externalId>false</externalId>
        <inlineHelpText>Amount to be charged to the customer for non returned or damaged card machines.</inlineHelpText>
        <label>Card Machine Charge</label>
        <precision>18</precision>
