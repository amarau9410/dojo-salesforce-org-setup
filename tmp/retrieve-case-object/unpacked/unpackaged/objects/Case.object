        <description>This field captures the reason generated by AI for summarizing the case, providing insights into the context or rationale behind the case summary.</description>
        <inlineHelpText>This field stores the AI-generated reason for the case summary. It helps in understanding the context or key points considered by AI when summarizing the case details. This information can be used for review and analysis purposes.</inlineHelpText>
        <label>AI Cause for Call</label>
        <length>500</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>SC_AccountManaged__c</fullName>
        <description>Indicates if the account is actively managed.</description>
        <inlineHelpText>Mark &apos;Yes&apos; if the account is managed, otherwise &apos;No&apos;.</inlineHelpText>
        <label>Account Managed?</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>account_managed</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>not_account_managed</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
