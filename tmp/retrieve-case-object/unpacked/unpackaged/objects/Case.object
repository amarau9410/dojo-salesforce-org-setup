    <fields>
        <fullName>SC_OwnerFormula__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  LEFT(OwnerId,3) = &quot;00G&quot;, Owner:Queue.QueueName,
   Owner:User.FirstName + &quot; &quot; +  Owner:User.LastName)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner Formula</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
