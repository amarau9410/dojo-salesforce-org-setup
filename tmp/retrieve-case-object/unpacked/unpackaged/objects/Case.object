    <fields>
        <fullName>SC_IsThisAnError__c</fullName>
        <description>Indicates if the situation is a mistake.</description>
        <inlineHelpText>Mark &apos;Yes&apos; if it is an error; otherwise &apos;No&apos;.</inlineHelpText>
        <label>Is This An Error?</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>yes_-_remediated</fullName>
                    <default>false</default>
                    <label>Yes - Remediated</label>
                </value>
                <value>
                    <fullName>yes_-_ongoing</fullName>
                    <default>false</default>
                    <label>Yes - Ongoing</label>
                </value>
                <value>
                    <fullName>no_error</fullName>
                    <default>false</default>
                    <label>No Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>SC_JourneyType__c</fullName>
        <description>Classification of the customer journey.</description>
        <inlineHelpText>Select the journey type from the list.</inlineHelpText>
        <label>Journey Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>journey_type_initial</fullName>
                    <default>false</default>
                    <label>Initial Journey</label>
                </value>
                <value>
                    <fullName>journey_type_45_day</fullName>
                    <default>false</default>
                    <label>45 day</label>
                </value>
                <value>
                    <fullName>journey_type_90_day</fullName>
                    <default>false</default>
                    <label>90 day</label>
                </value>
                <value>
                    <fullName>journey_type_180_day</fullName>
                    <default>false</default>
                    <label>180 day</label>
                </value>
