    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>ARDInThePast</fullName>
        <active>true</active>
        <description>Checks if the ARD is in the past when users move the Status to On Hold.</description>
        <errorConditionFormula>AND( NOT($Permission.SC_BypassValidationRules),
ISCHANGED( Status ),
ISPICKVAL(Status,&quot;On Hold - Internal&quot;),				
OR(
				 SC_ActionRequiredDateTime__c &lt;= NOW(),
				ISBLANK(SC_ActionRequiredDateTime__c)
				)
				)</errorConditionFormula>
        <errorMessage>Please input an ARD in the future before putting the case on hold - internal.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CS_CancellationFeeApplied</fullName>
        <active>true</active>
        <description>If Outcome = Cancelled then CancellationFeeApplied_c required.</description>
        <errorConditionFormula>AND(
ISCHANGED(Status),
ISPICKVAL(Status, &quot;Closed&quot;),
ISPICKVAL(SC_Outcome__c, &quot;Cancelled&quot;),
ISBLANK(TEXT(SC_CancellationFeeApplied__c))
)</errorConditionFormula>
        <errorMessage>Please complete Cancellation Fees Applied field before Saving the Record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CS_OutcomeForCertainRecordType</fullName>
        <active>true</active>
        <description>This Validation rule will fire when the status is changed to Close for certain record Type</description>
        <errorConditionFormula>AND(
				ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Closed&quot;),
    ISBLANK(TEXT(SC_Outcome__c)),
OR(
        RecordType.DeveloperName = &quot;General_Queries&quot;,
RecordType.DeveloperName = &quot;Account_Management&quot;,
RecordType.DeveloperName = &quot;WelcomeCall&quot;,
RecordType.DeveloperName = &quot;VQ_B&quot;,
RecordType.DeveloperName = &quot;Technical&quot;,
RecordType.DeveloperName = &quot;Funding&quot;,
RecordType.DeveloperName = &quot;ProactiveServiceCampaign&quot;,
RecordType.DeveloperName = &quot;Onboarding&quot;,
RecordType.DeveloperName = &quot;Loyalty&quot;,
RecordType.DeveloperName = &quot;Integration&quot;,
RecordType.DeveloperName = &quot;EnterpriseAccountManagement&quot;,
RecordType.DeveloperName = &quot;Complaint&quot;,
RecordType.DeveloperName = &quot;ChangeofLegalEntity&quot;,
RecordType.DeveloperName = &quot;Retentions&quot;,
RecordType.DeveloperName = &quot;Collections&quot;,
RecordType.DeveloperName = &quot;CardMachineCharges&quot;
    )
)</errorConditionFormula>
        <errorMessage>Please complete Outcome Field in order to Save Record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CS_OutcomeRequiredOnClose</fullName>
        <active>false</active>
        <description>Checks that the Outcome is entered when closed on General Queries</description>
        <errorConditionFormula>/*CS Only*/
NOT($Permission.SC_BypassValidationRules) &amp;&amp; RecordType.DeveloperName =&quot;General_Queries&quot;&amp;&amp;
TEXT(SC_Outcome__c)=&quot;&quot;
&amp;&amp;TEXT(Status)=&quot;Closed&quot;
&amp;&amp;
 SC_CaseAutoclosed__c = false</errorConditionFormula>
        <errorDisplayField>SC_Outcome__c</errorDisplayField>
        <errorMessage>Please select an Outcome reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CaseOnQueueAtAssignedStatus</fullName>
        <active>true</active>
        <description>Error when cases get assigned to queues when they&apos;re on Assigned status.</description>
        <errorConditionFormula>AND(
				ISCHANGED(OwnerId),
				BEGINS(OwnerId,&quot;00G&quot;),
				ISPICKVAL(Status,&quot;Assigned&quot;),
				NOT($Permission.SC_BypassValidationRules)
)</errorConditionFormula>
        <errorMessage>You can not assign this case to a queue in an &apos;Assigned&apos; status, please choose the correct status for the case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Chargebacks_ARDBeforeHold</fullName>
        <active>true</active>
        <description>Certan scenarios for chargebacks to enforce ARD before putting on hold</description>
        <errorConditionFormula>NOT($Permission.SC_BypassValidationRules)
&amp;&amp;
RecordType.DeveloperName = &quot;Chargebacks&quot;
&amp;&amp;
(ISPICKVAL (SC_ChargebacksScenario__c, &quot;Fraud SG&quot;) ||
	ISPICKVAL (SC_ChargebacksScenario__c, &quot;Pre Compliance&quot;))
&amp;&amp;
ISBLANK( SC_ActionRequiredDateTime__c )
&amp;&amp;
ISCHANGED(Status)
&amp;&amp; 
CONTAINS(TEXT(Status), &quot;On Hold&quot;)</errorConditionFormula>
        <errorMessage>Please set an Action Required Date before putting the case on hold.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Collections_LegalStage_Debt</fullName>
        <active>true</active>
        <description>Prevents users from updating Legal Journey Stage on Collections cases unless Collections Current Debt is populated and greater than 0; bypassed for users with SC_BypassValidationRules.</description>
        <errorConditionFormula>AND(   NOT($Permission.SC_BypassValidationRules),   
				RecordType.DeveloperName = &quot;Collections&quot;,   
				ISCHANGED(SC_LegalJourneyStage__c),   
				NOT(ISPICKVAL(SC_LegalJourneyStage__c, &quot;&quot;)),   
				OR(     ISBLANK(SC_CollectionsCurrentDebt__c),     
							SC_CollectionsCurrentDebt__c &lt;= 0   ) )</errorConditionFormula>
        <errorMessage>Legal Journey Stage can only be updated when Collections Current Debt is greater than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExpressedDissatisfactionDate</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
				AND(ISNEW(),
								BEGINS( TEXT(SC_ExpressedDissatisfaction__c ), &quot;yes&quot;),
        ISBLANK( SC_ExpressDissatisfactionRaisedDate__c ) 
								),

AND(
BEGINS( TEXT(SC_ExpressedDissatisfaction__c ), &quot;yes&quot;),
ISBLANK( SC_ExpressDissatisfactionRaisedDate__c ) ,
ISCHANGED(SC_ExpressDissatisfactionRaisedDate__c)
)
)</errorConditionFormula>
        <errorDisplayField>SC_ExpressDissatisfactionRaisedDate__c</errorDisplayField>
        <errorMessage>Expressed Dissatisfaction Raised Date can not be blank if Expressed Dissatisfaction? is &quot;yes&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GenQ_EnforceContact</fullName>
        <active>true</active>
        <description>Enforce contact on general queries when put on hold customer if there&apos;s no web email.</description>
        <errorConditionFormula>NOT($Permission.SC_BypassValidationRules) &amp;&amp; (RecordType.DeveloperName = &quot;General_Queries&quot; ||
RecordType.DeveloperName = &quot;Account_Management&quot;)
&amp;&amp;
 ISCHANGED(Status) &amp;&amp;
	ISPICKVAL(Status, &quot;On Hold - Customer&quot;) &amp;&amp;
	ISBLANK(ContactId) &amp;&amp;  
	ISBLANK(SuppliedEmail)</errorConditionFormula>
        <errorMessage>Please add a Contact or Web Email before putting the case status on &quot;On Hold - Customer&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnHoldWithoutQueueWarning</fullName>
        <active>true</active>
        <description>Rule to warn agents to assign a queue to the case before putting the case on hold.</description>
        <errorConditionFormula>RecordType.DeveloperName &lt;&gt;  &apos;Risk&apos; &amp;&amp;
RecordType.DeveloperName &lt;&gt;  &apos;Complaint&apos; &amp;&amp;
RecordType.DeveloperName &lt;&gt;  &apos;Chargebacks&apos; &amp;&amp;
RecordType.DeveloperName &lt;&gt;  &apos;EnterpriseAccountManagement&apos; &amp;&amp;
SC_Team__c &lt;&gt;  &apos;Partner Technology&apos; &amp;&amp;
SC_Team__c &lt;&gt;  &apos;Partnerships&apos; &amp;&amp;
SC_Team__c &lt;&gt;  &apos;KYC&apos; &amp;&amp;
ISBLANK(SC_LatestQueueId__c) &amp;&amp;
LEFT(OwnerId,3) =&apos;005&apos; 	&amp;&amp;
ISCHANGED(Status) &amp;&amp;
CONTAINS(TEXT(Status), &apos;On Hold&apos;)
&amp;&amp;
 NOT($Permission.SC_BypassValidationRules)</errorConditionFormula>
        <errorMessage>Please assign a queue to the case before putting the status on hold.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReadyToClose_Complaints</fullName>
        <active>false</active>
        <description>Checks to see if the complaints case is ready to close</description>
        <errorConditionFormula>/*Complaints*/
RecordType.DeveloperName =&quot;Complaint&quot;&amp;&amp;
TEXT(SC_ReadytoClose__c)!=&quot;Complaint - Ready&quot;
&amp;&amp;TEXT(Status)=&quot;Closed&quot;
&amp;&amp;
 NOT($Permission.SC_BypassValidationRules)</errorConditionFormula>
        <errorMessage>The complaint is not ready to close. Please check you have completed the Giveaway Value, SRC and Complaint Outcome before trying to close the case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SC_CommissionOutcomeNotNullOnCloseStatus</fullName>
        <active>true</active>
        <description>When attempting to Close the Case (Status) and Commission Outcome on Application Form is null</description>
        <errorConditionFormula>AND(
    SC_Record_Type_Formula__c=&quot;Sales Support&quot;,
    ISPICKVAL(Type, &quot;Switcher Statement Review&quot;),
    ISPICKVAL(Status, &quot;Closed&quot;), 
    ISBLANK(SC_CommissionOutcome__c)
)</errorConditionFormula>
        <errorMessage>You must select a Commission Outcome on the corresponding Application Form to close this Case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SC_InvalidSwitcherCommentRequired</fullName>
        <active>true</active>
        <description>When the Switcher Document Status has been updated from Attached to Invalid and Invalid Switcher Comment is blank</description>
        <errorConditionFormula>AND(
		SC_Record_Type_Formula__c=&quot;Sales Support&quot;,
  ISCHANGED(SC_SwitcherDocumentStatus__c),
  ISPICKVAL(PRIORVALUE(SC_SwitcherDocumentStatus__c), &quot;Attached&quot;),
  ISPICKVAL(SC_SwitcherDocumentStatus__c, &quot;Invalid&quot;),
  ISBLANK(SC_InvalidSwitcherComments__c)		
)</errorConditionFormula>
        <errorDisplayField>SC_InvalidSwitcherComments__c</errorDisplayField>
        <errorMessage>Please enter a comment explaining why the switcher was marked as invalid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SC_InvalidSwitcherReasonCommentRequired</fullName>
        <active>true</active>
        <description>When the SwitcherDocumentstatus has been updated from Attached to Invalid and Invalid Switcher Reason AND Invalid Switcher Comment is blank.</description>
        <errorConditionFormula>AND(
		SC_Record_Type_Formula__c=&quot;Sales Support&quot;,
  ISPICKVAL(SC_SwitcherDocumentStatus__c, &quot;Invalid&quot;),
  OR(
    ISPICKVAL(SC_InvalidSwitcherReason__c, &quot;&quot;),
    ISBLANK(SC_InvalidSwitcherComments__c)
  )
)</errorConditionFormula>
        <errorMessage>Both Invalid Switcher Reason and Comments are required when marking a switcher as invalid. Please complete both fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SC_InvalidSwitcherReasonRequired</fullName>
        <active>true</active>
        <description>When the Switcher Document status has been updated from Attached to Invalid, the fields Invalid Switcher Reason is blank</description>
        <errorConditionFormula>AND(
  SC_Record_Type_Formula__c=&quot;Sales Support&quot;,
		ISCHANGED(SC_SwitcherDocumentStatus__c),
  ISPICKVAL(PRIORVALUE(SC_SwitcherDocumentStatus__c), &quot;Attached&quot;),
  ISPICKVAL(SC_SwitcherDocumentStatus__c, &quot;Invalid&quot;),
  ISPICKVAL(SC_InvalidSwitcherReason__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>SC_InvalidSwitcherReason__c</errorDisplayField>
        <errorMessage>Please select an Invalid Switcher Reason before saving.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SC_ValidateAccountName</fullName>
        <active>true</active>
        <description>Validate that Account Name is complete on save or change of Status apart from New status</description>
        <errorConditionFormula>AND( 
				ISPICKVAL(SC_SourceofContact__c, &apos;Customer&apos;), 
				ISBLANK(Account.Name), 
				OR( 
								NOT(ISCHANGED(Status)),
								AND(
												ISCHANGED(Status),
												NOT(
																AND(
																				ISPICKVAL(PRIORVALUE(Status), &apos;New&apos;),
																				NOT(ISPICKVAL(Status, &apos;New&apos;))
																			)
												    )
											)
				    )
)</errorConditionFormula>
        <errorMessage>Please fill in account name for the customer before proceeding.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>TwilioSF__Twilio_Two_Way_Messages</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Twilio Two Way Messages</masterLabel>
        <openType>noSidebar</openType>
        <page>TwilioSF__TwoWayMessagesCase</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
