<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Split_percentages_must_add_up_to_100</fullName>
    <active>true</active>
    <description>DOJOP-6971</description>
    <errorConditionFormula>(AmexSplit__c +  CreditSplit__c +  DebitSplit__c +  OtherBizSplit__c + VisaBizSplit__c) != 1</errorConditionFormula>
    <errorMessage>The split percentages must add up to 100%</errorMessage>
</ValidationRule>
