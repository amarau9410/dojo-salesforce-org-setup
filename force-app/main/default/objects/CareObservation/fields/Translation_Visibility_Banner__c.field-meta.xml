<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Translation_Visibility_Banner__c</fullName>
    <description>UI banner text to highlight draft or unverified translations.</description>
    <externalId>false</externalId>
    <formula>IF(
OR(
ISPICKVAL(Translation_Status__c, "Pending"),
ISPICKVAL(Translation_Status__c, "Auto-translated")
),
"Draft/Unverified Translation",
""
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Translation Visibility Banner</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
