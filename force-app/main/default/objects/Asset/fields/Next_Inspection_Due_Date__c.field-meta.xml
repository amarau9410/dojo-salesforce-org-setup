<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Next_Inspection_Due_Date__c</fullName>
    <formula>IF(
ISBLANK(Last_Inspection_Date__c),
null,
ADDMONTHS(Last_Inspection_Date__c, Inspection_Frequency_Months__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Next Inspection Due Date</label>
    <required>false</required>
    <type>Date</type>
</CustomField>