<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minimum_CTO_Greater_Than_Maximum_CTO</fullName>
    <active>true</active>
    <description>DOJOR-50 Minimum CTO can&apos;t be greater than Maximum CTO</description>
    <errorConditionFormula>Minimum_CTO__c &gt;  Maximum_CTO__c</errorConditionFormula>
    <errorDisplayField>Minimum_CTO__c</errorDisplayField>
    <errorMessage>Minimum CTO can&apos;t be greater than Maximum CTO</errorMessage>
</ValidationRule>
