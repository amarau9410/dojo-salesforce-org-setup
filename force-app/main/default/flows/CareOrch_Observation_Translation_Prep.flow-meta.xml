<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Not_Required_Values</name>
        <label>Set Not Required Values</label>
        <locationX>50</locationX>
        <locationY>280</locationY>
        <assignmentItems>
            <assignToReference>$Record.English_Translation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Original_Observation__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Translation_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reviewed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Draft_Unverified_Translation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Pending_Values</name>
        <label>Set Pending Values</label>
        <locationX>302</locationX>
        <locationY>280</locationY>
        <assignmentItems>
            <assignToReference>$Record.Translation_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Draft_Unverified_Translation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decide_Translation_Path</name>
        <label>Decide Translation Path</label>
        <locationX>176</locationX>
        <locationY>160</locationY>
        <defaultConnectorLabel>No update needed</defaultConnectorLabel>
        <rules>
            <name>Mark_Not_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_English_Language</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.English_Translation__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Original_Observation__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Required_Values</targetReference>
            </connector>
            <label>Use original text as English translation</label>
        </rules>
        <rules>
            <name>Mark_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_English_Language</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.English_Translation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Translation_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Pending_Values</targetReference>
            </connector>
            <label>Set pending translation</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Is_English_Language</name>
        <dataType>Boolean</dataType>
        <expression>OR(
ISBLANK({!$Record.Original_Language__c}),
BEGINS(LOWER({!$Record.Original_Language__c}), &quot;en&quot;)
)</expression>
    </formulas>
    <interviewLabel>CareOrch Observation Translation Prep {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CareOrch Observation Translation Prep</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decide_Translation_Path</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Original_Observation__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>CareObservation</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
